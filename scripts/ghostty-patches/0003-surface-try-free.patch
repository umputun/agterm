+    /// Asks the surface's threads to stop without waiting for them and frees the
+    /// surface once they have exited, returning whether it did. Until then the
+    /// surface stays valid; call again later from the app thread, or use
+    /// `ghostty_surface_free`, which waits for them.
+    export fn ghostty_surface_try_free(ptr: *Surface) bool {
+        ptr.core_surface.beginStop();
+        if (!ptr.core_surface.threadsExited()) return false;
+        ptr.app.closeSurface(ptr);
+        return true;
+    }
