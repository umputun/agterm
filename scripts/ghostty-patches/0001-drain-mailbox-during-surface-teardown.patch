+/// Keep the app mailbox moving while the surface stops workers and waits for frames.
+/// Only this worker accesses deferred between start and finish.
+pub const TeardownDrain = struct {
+    app: *App,
+    surface: *const Surface,
+    stop: std.atomic.Value(bool) = .init(false),
+    thread: ?std.Thread = null,
+
+    pub fn start(self: *TeardownDrain) void {
+        // A second close can precede the next app tick, or run inside a drain that has
+        // already consumed part of deferred. Remove stale pointers from the unread
+        // messages before an address is reused, in one pass.
+        const head = self.app.deferred_head;
+        var write = head;
+        for (self.app.deferred.items[head..]) |message| {
+            const kept = self.keepMessage(message) orelse continue;
+            self.app.deferred.items[write] = kept;
+            write += 1;
+        }
+        self.app.deferred.shrinkRetainingCapacity(write);
+        self.thread = std.Thread.spawn(.{}, run, .{self}) catch |err| thread: {
+            log.warn("teardown drain thread spawn failed, may stall err={}", .{err});
+            break :thread null;
+        };
+    }
+
+    pub fn finish(self: *TeardownDrain) void {
+        const thread = self.thread orelse return;
+        self.stop.store(true, .release);
+        thread.join();
+        self.thread = null;
+    }
+
+    fn run(self: *TeardownDrain) void {
+        const io = global.io();
+        const capacity = @typeInfo(@FieldType(Mailbox.Queue, "data")).array.len;
+        while (true) {
+            // Once workers and in-flight frames have finished, one capacity-sized pass
+            // consumes every message they could have left in the FIFO. Bound
+            // each pass so other surfaces cannot starve the stop check.
+            const stopping = self.stop.load(.acquire);
+            for (0..capacity) |_| {
+                const message = self.app.mailbox.pop(io) orelse break;
+                const kept = self.keepMessage(message) orelse continue;
+                self.app.deferred.append(self.app.alloc, kept) catch |err| {
+                    discardMessage(kept);
+                    log.warn("dropping app message during surface teardown err={}", .{err});
+                };
+            }
+            if (stopping) return;
+            std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+        }
+    }
+
+    fn keepMessage(self: *const TeardownDrain, message: Message) ?Message {
+        var kept = message;
+        const discard = switch (kept) {
+            .close => |surface| surface == self.surface,
+            .surface_message => |msg| msg.surface == self.surface,
+            .redraw_surface => |surface| surface == self.surface.rt_surface,
+            .new_window => |*msg| blk: {
+                if (msg.parent == self.surface) msg.parent = null;
+                break :blk false;
+            },
+            .open_config, .quit => false,
+        };
+        if (!discard) return kept;
+        discardMessage(kept);
+        return null;
+    }
+};
+
+fn discardMessage(message: Message) void {
+    switch (message) {
+        .surface_message => |msg| switch (msg.message) {
+            .kitty_clipboard_read => |req| req.destroy(),
+            .kitty_clipboard_write => |req| req.destroy(),
+            .clipboard_write => |write| write.req.deinit(),
+            .pwd_change => |pwd| pwd.deinit(),
+            else => {},
+        },
+        else => {},
+    }
+}
