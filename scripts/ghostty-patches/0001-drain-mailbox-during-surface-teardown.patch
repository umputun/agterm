+    const unread = self.deferred.items.len - self.deferred_head;
+    std.mem.copyForwards(Message, self.deferred.items[0..unread], self.deferred.items[self.deferred_head..]);
+    self.deferred.shrinkRetainingCapacity(unread);
+    self.deferred_head = 0;
