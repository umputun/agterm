+/// Creates the session as an attach would, with no tty and no client: the
+/// command, or the login shell, starts in the daemon and this returns. A
+/// session that already answers is an error, so a supervisor that names a
+/// fresh session knows it started one.
+fn createDetached(gpa: std.mem.Allocator, io: std.Io, daemon: *Daemon, labels: ?[]const u8) !void {
+    var dir = try std.Io.Dir.openDirAbsolute(io, daemon.cfg.socket_dir, .{});
+    const exists = try socket.sessionExists(io, dir, daemon.session_name);
+    dir.close(io);
+    if (exists) {
+        if (ipc.connectSession(daemon.socket_path)) |fd| {
+            lib_posix.close(fd);
+            return printError(io, "session \"{s}\" exists", .{daemon.session_name});
+        } else |_| {}
+    }
+    const is_daemon_proc = try daemon.ensureSession(io);
+    if (is_daemon_proc) return;
+    if (labels) |kvs| {
+        try labelSet(gpa, io, daemon.cfg, daemon.session_name, kvs);
+    }
+}
