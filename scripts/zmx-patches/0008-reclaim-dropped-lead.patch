+/// Detect a mouse button press or wheel step in a terminal's mouse report, SGR (`CSI < b;x;y M`) or
+/// X10 (`CSI M` and three bytes). A release, motion and a focus report are not a press.
+pub fn isPointerPress(payload: []const u8) bool {
+    var i: usize = 0;
+    while (i + 2 < payload.len) : (i += 1) {
+        if (payload[i] != 0x1b or payload[i + 1] != '[') continue;
+        if (payload[i + 2] == 'M' and i + 3 < payload.len) {
+            const cb = payload[i + 3] -% 32;
+            if (cb & 32 == 0 and cb & 3 != 3) return true;
+            continue;
+        }
+        if (payload[i + 2] != '<') continue;
+        var pos = i + 3;
+        const button = parseDecimal(payload, &pos) orelse continue;
+        while (pos < payload.len and (std.ascii.isDigit(payload[pos]) or payload[pos] == ';')) pos += 1;
+        if (pos < payload.len and payload[pos] == 'M' and button & 32 == 0) return true;
+    }
+    return false;
+}
