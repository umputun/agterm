+        try list.ensureUnusedCapacity(alloc, @sizeOf(Header) + data.len);
+        list.appendSliceAssumeCapacity(&self.header(tag, @intCast(data.len)));
+        list.appendSliceAssumeCapacity(data);
+    }
+};
