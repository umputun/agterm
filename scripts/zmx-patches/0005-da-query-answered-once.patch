+    /// clientOutput answers DA queries while no terminal client is attached and returns the PTY output clients get
+    /// without them, owned by the caller; null sends `data` as it is.
+    fn clientOutput(self: *Daemon, gpa: std.mem.Allocator, data: []const u8) ?[]u8 {
+        if (self.hasTerminalClient() or self.pty_write_buf.items.len >= PTY_WRITE_BUF_MAX) return null;
+        return util.respondToDeviceAttributes(gpa, &self.pty_write_buf, data);
+    }
