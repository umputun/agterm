 }
+
+test "respondToDeviceAttributes answers each query and returns the output without it" {
+    const alloc = testing.allocator;
+    var replies: std.ArrayList(u8) = .empty;
+    defer replies.deinit(alloc);
+    const kept = respondToDeviceAttributes(alloc, &replies, "a\x1b[cb\x1b[>0cc\x1b[0c") orelse return error.TestUnexpectedResult;
+    defer alloc.free(kept);
+    try testing.expectEqualStrings("abc", kept);
+    try testing.expectEqualStrings(DA1_RESPONSE ++ DA2_RESPONSE ++ DA1_RESPONSE, replies.items);
+}
+
+test "respondToDeviceAttributes leaves output without a whole query alone" {
+    const alloc = testing.allocator;
+    var replies: std.ArrayList(u8) = .empty;
+    defer replies.deinit(alloc);
+    for ([_][]const u8{ "plain", DA1_RESPONSE, "\x1b[", "\x1b[>", "\x1b[0", "\x1b[1c" }) |data| {
+        try testing.expect(respondToDeviceAttributes(alloc, &replies, data) == null);
+    }
+    try testing.expectEqualStrings("", replies.items);
+}
