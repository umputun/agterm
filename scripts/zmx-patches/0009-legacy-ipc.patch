+    fn decode(self: Wire, bytes: *const [@sizeOf(Header)]u8) Header {
+        return switch (self) {
+            .current => std.mem.bytesToValue(Header, bytes),
+            .legacy => .{
+                .tag = @fromBackingInt(@intCast(bytes[0])),
+                .len = std.mem.readInt(u32, bytes[1..5], .little),
+            },
+        };
+    }
